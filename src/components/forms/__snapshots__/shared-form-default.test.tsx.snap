<main><header class="wb-onboarding-band"><div class="wb-onboarding-wrap"><p class="wb-onboarding-count" aria-live="polite">Step 3 of 3</p><h1>Your membership is active</h1><p class="wb-onboarding-lede">Your profile is saved. Continue to your challenges.</p><div class="wb-onboarding-steps"><div class="wb-onboarding-step"><div class="wb-onboarding-step-dot" data-state="complete"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check size-4" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></div><div class="wb-onboarding-step-line" data-complete="true" aria-hidden="true"></div><span class="wb-onboarding-step-label" data-state="complete">Preferences</span></div><div class="wb-onboarding-step"><div class="wb-onboarding-step-dot" data-state="complete"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check size-4" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></div><div class="wb-onboarding-step-line" data-complete="true" aria-hidden="true"></div><span class="wb-onboarding-step-label" data-state="complete">Profile</span></div><div class="wb-onboarding-step"><div class="wb-onboarding-step-dot" data-state="active" aria-current="step">3</div><span class="wb-onboarding-step-label" data-state="active">Plan</span></div></div></div></header><div class="wb-onboarding-sheet"><div class="wb-onboarding-body"><div class="wb-onboarding-card wb-onboarding-panel"><a class="wb-onboarding-primary" href="/challenges">Continue to your challenges</a></div></div></div></main>
