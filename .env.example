# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Paid Checkout is fail-closed. Leave unset or set to any value other than
# the exact string "true" to refuse new Checkout Sessions.
# Production: leave unset (checkout disabled).
# Local/preview: set to true only with Stripe test-mode keys, a test Price,
# and test webhooks. Never use Stripe live keys for preview E2E testing.
# Existing members can still open the Stripe Customer Portal to cancel.
# CHECKOUT_ENABLED=

# Email
RESEND_API_KEY=

# Rate limiting (optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Places (optional)
GOOGLE_PLACES_API_KEY=

# Sentry (error monitoring)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional: source map upload in CI
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# PostHog (analytics)
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_HOST=

# Vercel cron (Bearer token for /api/cron/* routes)
CRON_SECRET=

# Redemption code encryption (32-byte key, base64)
REDEMPTION_CODE_ENCRYPTION_KEY=

# Roulette / AI (fail-closed)
# Preview and production must keep WANDERBITE_AI_DISABLED=true until
# fallback, secret, Redis, replay, timeout, transfer, and stale-recovery
# tests pass. Rollback is this kill switch, not unmetered roulette.
# Exact lowercase "true" disables billable AI (any other value is not a kill).
WANDERBITE_AI_DISABLED=true
WANDERBITE_GUEST_SIGNING_SECRET=
WANDERBITE_IP_HASH_SECRET=
ANTHROPIC_API_KEY=

# Password reset (fail-closed throttles)
# Exact lowercase "true" freezes NEW reset emails. Completing an already-issued
# recovery link still works. Rollback is this kill switch, not fail-open Redis
# or leaking Auth error.message. Preview/production default: leave unset
# (throttled resets allowed). Set true only to freeze requests.
# WANDERBITE_PASSWORD_RESET_DISABLED=
