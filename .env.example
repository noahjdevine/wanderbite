# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Paid Checkout is fail-closed. Leave unset or set to any value other than
# the exact string "true" to refuse new Checkout Sessions.
# Production: leave unset (checkout disabled).
# Local/preview: set to true only with Stripe test-mode keys, a test Price,
# and test webhooks. Never use Stripe live keys for preview E2E testing.
# Existing members can still open the Stripe Customer Portal to cancel.
# CHECKOUT_ENABLED=

# Email
RESEND_API_KEY=

# Rate limiting (optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Places (optional)
GOOGLE_PLACES_API_KEY=

# Sentry (error monitoring)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional: source map upload in CI
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# PostHog (analytics)
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_HOST=

# Vercel cron (Bearer token for /api/cron/* routes)
CRON_SECRET=

# Redemption code encryption (32-byte key, base64)
REDEMPTION_CODE_ENCRYPTION_KEY=

# Roulette / AI (fail-closed)
# Preview and production must keep WANDERBITE_AI_DISABLED=true until
# fallback, secret, Redis, replay, timeout, transfer, and stale-recovery
# tests pass. Rollback is this kill switch, not unmetered roulette.
# Exact lowercase "true" disables billable AI (any other value is not a kill).
WANDERBITE_AI_DISABLED=true
WANDERBITE_GUEST_SIGNING_SECRET=
WANDERBITE_IP_HASH_SECRET=
ANTHROPIC_API_KEY=
# File transcription for Discover push-to-talk. Server-only. Never NEXT_PUBLIC_.
# Required before voice calls OpenAI. Missing key returns typed fallback.
OPENAI_API_KEY=

# Password reset (fail-closed throttles)
# Exact lowercase "true" freezes NEW reset emails. Completing an already-issued
# recovery link still works. Rollback is this kill switch, not fail-open Redis
# or leaking Auth error.message. Preview/production default: leave unset
# (throttled resets allowed). Set true only to freeze requests.
# WANDERBITE_PASSWORD_RESET_DISABLED=

# Partner login and new QR issuance (fail-closed throttles)
# Exact lowercase "true" freezes NEW PIN sessions or NEW redemption codes.
# Existing partner cookies and already-issued code replay still work.
# Do not unset the shared Redis token to freeze one of these paths.
# Preview/production default: leave unset. Set true only to freeze.
# WANDERBITE_PARTNER_LOGIN_DISABLED=
# WANDERBITE_REDEMPTION_ISSUANCE_DISABLED=

# Google Places photo proxy (fail-closed)
# Exact lowercase "true" freezes outbound Place calls, including the photo proxy.
# Cards then use a /images path or the placeholder. Leave unset so place-id
# import and the proxy keep working. Rollback is this switch.
# WANDERBITE_GOOGLE_PLACES_OUTBOUND_DISABLED=

# Monthly challenge curation on /challenges (fail-closed).
# Exact lowercase "true" replaces member Generate Challenge with the reveal flow
# and makes the 1st-of-month crons skip members who can curate.
# Unset, or any other value, keeps today’s challenges page. Leave this unset.
# E04_MONTHLY_REVEAL_ENABLED=

# AI ordering of the monthly reveal candidate list (fail-closed).
# Exact lowercase "true" AND E04_MONTHLY_REVEAL_ENABLED=true asks Claude Haiku
# (claude-haiku-4-5-20251001, ANTHROPIC_API_KEY) to rank server candidate ids. Any other value, a missing key,
# or a model failure keeps the deterministic pair. Leave this unset.
# E04_AI_RANKING_ENABLED=

# Recipe cards on a challenge restaurant, its passport visit, and saved recipes.
# Exact lowercase "true" shows published recipes. Unset, or any other value, leaves
# those pages unchanged. Leave this unset.
# E05_RECIPES_ENABLED=

# Grounded recipe and visit questions in Discover, plus journal links to saved recipes.
# Exact lowercase "true" AND E05_RECIPES_ENABLED=true. Unset, or any other value,
# leaves the Discover prompt and journal unchanged. Leave this unset.
# E05_RECIPE_QA_ENABLED=

# Discover streaming contract (fail-closed). Exact lowercase "true" enables
# POST /api/discover, which streams the same pick as /api/roulette.
# Unset, or any other value, returns 404 and leaves /api/roulette unchanged.
# Leave this unset. Do not set it in Vercel from this change.
# DISCOVER_STREAM_ENABLED=

# Operator content refresh (npm run content:refresh). Leave both unset.
# APPLY=1 allows local register, refresh --apply, resolve, and rollback.
# HOSTED_OK=1 is a second switch Noah sets only for a hosted run he approved.
# WANDERBITE_CONTENT_REFRESH_APPLY=
# WANDERBITE_CONTENT_REFRESH_HOSTED_OK=

# Scheduled content refresh at /api/cron/content-refresh. Exact lowercase "true"
# runs the maintenance pipeline once per America/Chicago day under a G17-E lease.
# Unset, or any other value, leaves that cron auth-checked and inert. Leave this unset.
# E05_CONTENT_REFRESH_CRON_ENABLED=

# Dated activity expiry and venue/event refresh inside /api/cron/content-refresh.
# Exact lowercase "true", and only when E05_CONTENT_REFRESH_CRON_ENABLED is also
# "true". Unset, or any other value, leaves that cron on its menu-only path
# and does not query activities. Leave this unset. Do not set it in Vercel
# from this change.
# E06_ACTIVITY_MAINTENANCE_CRON_ENABLED=

# Optional nearby ideas on a challenge restaurant (fail-closed).
# Exact lowercase "true" shows up to two catalog suggestions under the restaurant.
# Unset, or any other value, leaves the challenge page unchanged and does not
# query activities. Leave this unset. Unsetting it hides the block without a deploy.
# E06_ACTIVITIES_ENABLED=

# Passport map raster (optional). Leave both unset to keep the OpenStreetMap
# XYZ default and its attribution. Before launch traffic, set a non-OSM
# template that contains {z}, {x}, and {y}, plus that provider's attribution.
# Do not put a provider key in the attribution string.
# The report-only document CSP picks up this URL's origin (img-src and
# connect-src) automatically. A key in the query string is not copied.
# NEXT_PUBLIC_MAP_TILES_URL=
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# Private journal reflections (fail-closed). Exact lowercase "true" lets member
# server actions read and save journal_reflections and build a Google review
# handoff URL. Unset, or any other value, returns disabled and does not query
# that table. Leave this unset. Do not set it in Vercel from this change.
# The table migration is not applied to hosted.
# E08_JOURNAL_REFLECTIONS_ENABLED=

# Member visit-problem reports (fail-closed). Exact lowercase "true" lets a
# member file one open case on their own visit and lets an admin review it.
# Unset, or any other value, leaves the challenge card, visit screen, and
# admin queue unchanged and does not query visit_problem_cases. Leave this
# unset. Do not set it in Vercel from this change. The migration is not
# applied to hosted. This does not correct a visit, savings, or credits.
# E07_VISIT_PROBLEMS_ENABLED=

# Progression ledger write after a partner verifies a visit (fail-closed).
# Exact lowercase "true" calls record_verified_visit_progress once for the
# claimed redemption. Unset, or any other value, leaves partner verify
# unchanged and does not call that function. A failed call does not change
# the verify response. Leave this unset. Do not set it in Vercel from this
# change. The ledger migration is not applied to hosted. Nothing reads the ledger.
# E09_PROGRESSION_LEDGER_ENABLED=

# Admin sample-fulfillment buttons on /admin/drawings (fail-closed). Exact
# lowercase "true" shows create, mark ready, mark fulfilled, and forfeit, and
# only when E09_DRAWINGS_ADMIN_ENABLED and E09_DRAWINGS_ADMIN_ACTIONS_ENABLED
# are also exactly "true". Unset, empty, or any other value leaves the page
# as the E09-B8a page (or the read-only list) and the fulfillment actions
# return disabled before the admin check. A cost above the campaign's
# fulfillment allowance warns and asks for a second click. It does not block.
# Leave this unset. Do not set it in Vercel from this change. No migration.
# Nothing is sent to a member, and nothing ships.
# E09_DRAWINGS_FULFILLMENT_ACTIONS_ENABLED=

# Admin draft sample-campaign editor on /admin/drawings (fail-closed). Exact
# lowercase "true" shows New sample campaign and Edit on draft sample
# campaigns, and only when E09_DRAWINGS_ADMIN_ENABLED and
# E09_DRAWINGS_ADMIN_ACTIONS_ENABLED are also exactly "true". Unset, empty,
# or any other value leaves the page as the E09-B9 page (or B8a or the
# read-only list) and the create and edit actions return disabled before
# the admin check. This saves draft sample campaigns only. It does not
# activate, draw, delete, or contact a member. Leave this unset. Do not set
# it in Vercel from this change. No migration.
# E09_DRAWINGS_CAMPAIGN_EDITOR_ENABLED=

# Member sample-drawing card on Progress (fail-closed). Exact lowercase "true"
# shows the current America/Chicago quarter's sample campaign inside the levels
# panel, and only when E09_MEMBER_PROGRESSION_UI_ENABLED is also exactly "true".
# Unset, empty, or any other value leaves Progress unchanged and does not read
# a drawing table. The card is read-only. It does not enter a member, draw,
# or contact anyone. Leave this unset. Do not set it in Vercel from this change.
# No migration.
# E09_MEMBER_DRAWING_CARD_ENABLED=
