# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Paid Checkout is fail-closed. Leave unset or set to any value other than
# the exact string "true" to refuse new Checkout Sessions.
# Existing members can still open the Stripe Customer Portal to cancel.
# CHECKOUT_ENABLED=

# Email
RESEND_API_KEY=

# Rate limiting (optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Places (optional)
GOOGLE_PLACES_API_KEY=

# Sentry (error monitoring)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional: source map upload in CI
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# PostHog (analytics)
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_HOST=

# Vercel cron (Bearer token for /api/cron/* routes)
CRON_SECRET=

# Redemption code encryption (32-byte key, base64)
REDEMPTION_CODE_ENCRYPTION_KEY=

# Roulette (optional)
ANTHROPIC_API_KEY=
